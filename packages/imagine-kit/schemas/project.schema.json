{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Ajv strict mode: properties must be defined for required keywords in blocked items",
  "definitions": {
    "valueMap": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^(item|([a-z0-9.]+:)?[0-9a-f]{64})$" } },
    "item": { "type": "object", "required": ["kind", "status"], "additionalProperties": false, "properties": {
      "kind": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "status": { "enum": ["pending", "proposed", "approved", "rejected"] },
      "gate": { "type": "string" },
      "decision": { "type": "object", "required": ["decision", "at"], "anyOf": [{ "required": ["quote"], "properties": { "quote": true } }, { "required": ["source"], "properties": { "source": true } }], "additionalProperties": false, "properties": {
        "decision": { "enum": ["approve", "reject"] }, "quote": { "type": "string", "pattern": "\\S" },
        "source": { "type": "string", "pattern": "^checkpoint:Q[123]$" },
        "note": { "type": "string" }, "at": { "type": "string" } } },
      "state": { "enum": ["pending", "validating", "passed", "failed", "repairing", "needs_input", "ready", "published"] },
      "evidence": { "type": "array", "items": { "type": "object",
        "required": ["evaluator", "evaluatorCapabilities", "ruleVersion", "inputHashes", "outputRefs", "at", "result", "checkId"],
        "additionalProperties": false,
        "properties": {
          "evaluator": { "type": "string", "minLength": 1 },
          "evaluatorCapabilities": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "ruleVersion": { "type": "string", "minLength": 1 },
          "inputHashes": { "$ref": "#/definitions/valueMap" },
          "outputRefs": { "type": "array", "items": { "type": "string" } },
          "at": { "type": "string" },
          "result": { "enum": ["passed", "failed", "not_run"] },
          "checkId": { "type": "string", "minLength": 1 } } } },
      "repairs": { "type": "object", "additionalProperties": { "type": "object", "required": ["attempts", "strategiesTried"], "additionalProperties": false,
        "properties": { "attempts": { "type": "integer", "minimum": 0 }, "strategiesTried": { "type": "array", "items": { "type": "string" } } } } },
      "rev": { "type": "integer", "minimum": 0 },
      "inputs": { "$ref": "#/definitions/valueMap" },
      "watch": { "$ref": "#/definitions/valueMap" },
      "patch": { "type": "object", "required": ["file", "sha256"], "additionalProperties": false, "properties": {
        "file": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "brief_hash": { "type": "string" } } } } }
  },
  "type": "object",
  "required": ["title", "slug", "created", "contract", "g0", "stages", "items", "blocked"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "contract": { "const": 1 },
    "g0": {
      "type": "object",
      "required": ["status", "format", "width", "height", "fps", "audio_mode", "language", "duration_s", "platform", "silence"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["pending", "approved"] },
        "format": { "enum": ["landscape", "portrait"] },
        "width": { "enum": [1920, 1080] },
        "height": { "enum": [1080, 1920] },
        "fps": { "const": 30 },
        "audio_mode": { "enum": ["narrated", "music-led", "text-led"] },
        "language": { "type": ["string", "null"] },
        "duration_s": { "type": "object", "required": ["min", "max"], "properties": { "min": { "type": "number", "exclusiveMinimum": 0 }, "max": { "type": "number" } } },
        "platform": { "enum": ["generic", "tiktok", "reels", "shorts", "youtube"] },
        "silence": { "enum": [null, "intentional"] }
      },
      "allOf": [
        { "if": { "properties": { "format": { "const": "landscape" } } }, "then": { "properties": { "width": { "const": 1920 }, "height": { "const": 1080 } } } },
        { "if": { "properties": { "format": { "const": "portrait" } } }, "then": { "properties": { "width": { "const": 1080 }, "height": { "const": 1920 } } } }
      ]
    },
    "stages": { "type": "object" },
    "items": { "type": "object", "additionalProperties": { "$ref": "#/definitions/item" } },
    "blocked": { "type": "array", "items": { "type": "object", "required": ["step", "command", "since"], "properties": { "step": {}, "command": {}, "since": {} } } },
    "pending": {
      "type": "object",
      "required": ["rev", "prev"],
      "additionalProperties": false,
      "properties": {
        "rev": { "type": "integer", "minimum": 0 },
        "prev": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "$ref": "#/definitions/item" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "consents": { "type": "array", "items": { "type": "object",
      "required": ["kind", "scope", "quote", "at"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["material_change", "publication", "legacy_approval"] },
        "scope": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "pattern": "\\S" },
        "fileHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "at": { "type": "string" } } } },
    "purges": { "type": "array", "items": { "type": "object", "required": ["at", "quote", "files", "bytes"], "additionalProperties": false,
      "properties": { "at": { "type": "string" }, "quote": { "type": "string", "pattern": "\\S" }, "files": { "type": "integer", "minimum": 0 }, "bytes": { "type": "integer", "minimum": 0 } } } }
  }
}
