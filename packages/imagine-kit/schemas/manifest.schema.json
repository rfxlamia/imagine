{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Ajv strict mode: properties must be defined in then branch for required keywords",
  "type": "object",
  "required": ["assets"],
  "additionalProperties": false,
  "properties": { "assets": { "type": "array", "items": {
    "type": "object",
    "required": ["id", "kind", "v", "path", "sha256", "status"],
    "properties": {
      "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
      "kind": { "enum": ["ref", "img", "vo", "music", "sfx"] },
      "v": { "type": "integer", "minimum": 1 },
      "path": { "type": "string", "pattern": "^assets/(?!.*\\.\\.)[A-Za-z0-9_./-]+\\.[A-Za-z0-9]+$" },
      "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "status": { "enum": ["pending", "approved", "rejected", "stale"] },
      "refs": { "type": "array", "items": { "type": "string" } },
      "required_px": { "type": "object", "properties": { "w": { "type": "number" }, "h": { "type": "number" } } },
      "w": { "type": "integer" }, "h": { "type": "integer" },
      "q": { "type": "number" },
      "tier": { "enum": ["native", "soft", "replan"] },
      "prompt": { "type": "string" }, "revised_prompt": { "type": "string" },
      "license": { "type": "string", "minLength": 1 },
      "source": { "type": "string", "minLength": 1 },
      "credit": { "type": "string", "minLength": 1 },
      "line": { "type": "string" }, "text": { "type": "string" }, "tts_text": { "type": "string" },
      "voice": { "type": "string" }, "seed": { "type": "integer" }, "take": { "type": "integer" },
      "params_hash": { "type": "string" }, "duration_s": { "type": "number" },
      "listen_status": { "enum": ["pending", "ok", "redo"] }, "note": { "type": "string" },
      "engine": { "enum": ["pocket-tts", "elevenlabs"] },
      "model_id": { "type": "string" }, "voice_id": { "type": "string" },
      "language_code": { "type": "string" }, "provider_tier": { "type": "string" }
    },
    "if": { "properties": { "kind": { "enum": ["music", "sfx"] } } },
    "then": {
      "properties": { "license": {}, "source": {}, "credit": {} },
      "required": ["license", "source", "credit"]
    }
  } } }
}
