{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "assets/plan.yaml (source-formats.md section 11): planned raster assets generated by img.",
  "type": "object",
  "required": ["assets"],
  "additionalProperties": false,
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "prompt", "framing", "size"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
          "kind": { "enum": ["ref", "img"] },
          "prompt": { "type": "string", "pattern": "\\S" },
          "framing": { "type": "string", "pattern": "\\S" },
          "size": { "type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$" },
          "refs": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" } },
          "sheet": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
          "required_px": {
            "type": "object",
            "required": ["w", "h"],
            "additionalProperties": false,
            "properties": { "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 } }
          }
        },
        "if": {
          "properties": { "kind": { "const": "img" } }
        },
        "then": {
          "properties": { "required_px": true },
          "required": ["required_px"]
        }
      }
    }
  }
}
