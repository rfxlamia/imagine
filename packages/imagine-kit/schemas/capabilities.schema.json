{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "contract", "commands"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "contract": { "const": 1 },
    "commands": { "type": "object", "additionalProperties": {
      "type": "object", "required": ["status"], "additionalProperties": false,
      "properties": { "status": { "enum": ["implemented", "experimental", "not_implemented"] }, "note": { "type": "string" } } } }
  }
}
