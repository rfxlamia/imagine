# Research clones (not submodules): production uses pinned releases
# (hyperframes@0.8.223 via npm, pocket-tts==4.0.1 via uv).
/packages/hyperframes/
/packages/pocket-tts/

# Planning material, not shipped
/.internal/
/spikes/
# Planning docs (pre-.internal); new planning material goes to .internal/.
/docs/architecture-proposal.md
/docs/architecture-proposal-v0.1.md
/docs/phase0-spike-report.md

# Template placeholders
/packages/placeholder/
/skills/placeholder/
/agents/placeholder.md

# Imagine workspaces created by the plugin at runtime
.imagine/

# Media (generated or user-supplied; never committed)
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.mp4
*.mov
*.webm
*.mkv
*.gif
*.png
# Brand mark referenced by README.md. Other images stay ignored.
!img/logo.png
# Contact sheets committed as slice evidence for sequential-shorts.
!tests/slice/evidence/sequential-shorts/*.png
*.jpg
*.jpeg
*.webp
*.avif

# Node / Python
node_modules/
__pycache__/
*.pyc
.venv/

# Behavioural pack manifests: transient per-run artifacts. The auditable
# record of what was uploaded is the bundle sha256 and commit in the result
# header.
tests/behavioral/packs/

# OS / editor
.DS_Store
*.log

# Local Obsidian vault config
.obsidian/
copilot/
.opencode/
.copilot/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Non-Claude harness integrations and bd byproducts (not used here)
/.codex/
/.cursor/
/.agents/
/.beads/hooks/*.backup
/.beads/PRIME.md
/.pi/
/.workbuddy-ai/

# Local Claude cache and skills. Only project settings stay tracked.
/.claude/*
!/.claude/settings.json
